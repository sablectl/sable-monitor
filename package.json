{
  "name": "sable-monitor",
  "version": "1.0.0",
  "description": "Real-time Linux monitoring and diagnostics — a local metrics agent, a historical store, configurable alerts and a terminal-styled web dashboard.",
  "type": "module",
  "license": "MIT",
  "author": "Sable <355646062+sablectl@users.noreply.github.com>",
  "homepage": "https://github.com/sablectl/sable-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sablectl/sable-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/sablectl/sable-monitor/issues"
  },
  "keywords": [
    "monitoring",
    "linux",
    "metrics",
    "dashboard",
    "observability",
    "proc",
    "self-hosted",
    "typescript"
  ],
  "bin": {
    "sable-monitor": "./dist/bin/sable-monitor.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "tsc -p tsconfig.web.json && node scripts/copy-web.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "bench": "node scripts/bench.js",
    "start": "node dist/bin/sable-monitor.js start",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test && npm run test:integration && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
